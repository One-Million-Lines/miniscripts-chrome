{
  "name": "miniscripts-extension",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.extension.ts --mode development",
    "dev:watch": "vite build --config vite.config.extension.ts --mode development --watch",
    "dev:helper": "node dev-helper.js",
